# ═══════════════════════════════════════════════════════════════════════════
#  KG Cosmos · 环境变量模板
# ═══════════════════════════════════════════════════════════════════════════
#
#  **怎么用**：拷成 `.env` 后按需改；不改也能跑 —— 下面每一项**都标了默认值**，
#  只有标「⚠️ 必须设」的才真的需要你填。
#
#  **本文件是扫描出来的，不是手写的**：`tools/_probe/_probe_env_vars.py`
#  扫描 `src/` 与 `tools/` 里全部 `os.environ.get(...)`，共 **33 个**变量。
#  这样能保证**不漏**（漏一个的症状往往是"某功能静默降级"，很难查）。
#
#  ⚠️ **不要把真实密钥写进这个文件** —— 它是要进版本控制的模板。
#  ═══════════════════════════════════════════════════════════════════════════


# ── 1. Neo4j（图数据库，必需）─────────────────────────────────────────────
# 默认值与 `tools/serve.py` 的本地安装一致，本机跑不用改。
KG_NEO4J_URI=bolt://localhost:7687
KG_NEO4J_USER=neo4j
KG_NEO4J_PASSWORD=kgdemo2026

# 存储后端。`neo4j` 是默认；改成其它值会走内存态（仅供离线演示）。
KG_BACKEND=neo4j


# ── 2. 本地模型（Ollama，抽取与问答都用）─────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434

# 多 Agent 问答用的模型。默认 `qwen3.5:9b`（约 5.1 GB 显存）。
KG_QA_MODEL=qwen3.5:9b


# ── 3. 云端通道（⚠️ 默认关闭，且**有硬保护**）─────────────────────────────
#
# **安全设计（踩过坑之后加的）**：`src/kg_extractor.py` 里有一份 BLOCKED 集合，
# **故意不从系统注册表自动注入云端密钥** —— 防止任何 `import` 该模块的脚本
# 误调用付费 API。要真用云端，必须**同时**设 `KG_ALLOW_CLOUD=1`。
# 本会话余额只剩 ¥3，**不要开**。
KG_ALLOW_CLOUD=0

# 下面这些**留空即可**，只有真要走云端时才填。
DEEPSEEK_API_KEY=
DS_BASE=https://api.deepseek.com
DS_MODEL=deepseek-chat
DS_MAX_TOKENS=8192
DS_EXTRA_HEADERS=
SF_API_KEY=
COMMAND_API_KEY=
ANTHROPIC_AUTH_TOKEN=


# ── 4. 抽取行为（一般不用改）──────────────────────────────────────────────
# 提示词风格：`split` = 实体与关系分两轮问（默认，更稳）。
KG_EXTRACT_STYLE=split

# 抽取并发数。默认 1（**本机 8GB 显存，调大会 OOM**）。
KG_EXTRACT_WORKERS=1

# 关系类型是否只给裸列表（`1` = 不给语义定义，用于 A/B 对照实验）。
KG_BARE_RELATION_TYPES=0


# ── 5. 语料批处理（只在 `tools/ingest_corpus.py` 等脚本里用）──────────────
KG_INGEST_MODE=local
KG_CHUNK_CHARS=500
KG_BATCH_ID=
KG_ONLY=
CHANNEL_CHUNKS=0
CHANNEL_WORKERS=1

# 抽取记录的落盘目录（留空则不记）。
KG_RECORD_DIR=


# ── 6. 网络代理（**仅在国内网络访问 HuggingFace / arXiv 时需要**）─────────
#
# 实测：本机 `arxiv.org` 与 `export.arxiv.org` **全部不可达（HTTP 000）**，
# 而 OpenAlex / Crossref / Semantic Scholar 可达。要拉 arXiv PDF 或
# HuggingFace 模型时才需要下面这些。
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
HF_ENDPOINT=
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=
