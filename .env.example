# ═══════════════════════════════════════════════════════════════════════════
#  KG Cosmos · 环境变量模板
# ═══════════════════════════════════════════════════════════════════════════
#
#  **怎么用**：拷成 `.env` 后按需改；不改也能跑 —— 下面每一项**都标了默认值**，
#  只有标「⚠️ 必须设」的才真的需要你填。
#
#  **本文件是扫描出来的，不是手写的**：用一次性扫描脚本把 `src/` 与 `tools/`
#  里全部 `os.environ.get(...)` / `os.getenv(...)` 扫一遍，共 **54 个**变量。
#  这样能保证**不漏**（漏一个的症状往往是"某功能静默降级"，
#  很难查）。
#
#  ⚠️ **2026-09-19 补齐过一次**：此前本文件只有 32 个变量，但自述"保证不漏" ——
#  于是写了差集脚本（扫代码 vs 扫本文件）做一次比对，
#  实测**缺 22 个**（含 `KG_OLLAMA_TIMEOUT` / `KG_OLLAMA_RETRIES` 这两个直接
#  影响抽取产出量的）。全部补在下面，补的每条都标了代码里的真实默认值。
#  要复核：重跑同一比对（代码 vs 本文件），应为「模板缺失 0 个」。
#
#  ⚠️ **不要把真实密钥写进这个文件** —— 它是要进版本控制的模板。
#  ═══════════════════════════════════════════════════════════════════════════


# ── 1. Neo4j（图数据库，必需）─────────────────────────────────────────────
# 默认值与 `tools/serve.py` 的本地安装一致，本机跑不用改。
KG_NEO4J_URI=bolt://localhost:7687
KG_NEO4J_USER=neo4j
KG_NEO4J_PASSWORD=kgdemo2026

# 存储后端。`neo4j` 是默认；改成其它值会走内存态（仅供离线演示）。
# ⚠️ 两个调用点的兜底**不一致**：`src/app.py` 是 `neo4j`，
#    `tools/ingest_corpus.py` 是 `networkx`（不设这项时批处理落内存，不写库）。
KG_BACKEND=neo4j


# ── 2. 本地模型（Ollama，抽取与问答都用）─────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434

# 多 Agent 问答用的模型。默认 `qwen3.5:9b`（约 5.1 GB 显存）。
KG_QA_MODEL=qwen3.5:9b

# 单次 Ollama 请求的超时（秒）与失败重试次数。默认 **300 / 2** ——
# 与 `src/kg_extractor.py` 的 `call_openai_compat(timeout=300, retries=2)` 对齐。
# ⚠️ 别往小改：这两个数曾让首版中文图只有 95 节点/90 边 —— 原来写死 120s
# 且不重试，而 35 个 chunk 里有 14 个 ReadTimeout，最慢的单 chunk 实测 118s。
KG_OLLAMA_TIMEOUT=300
KG_OLLAMA_RETRIES=2

# 向量检索（`src/embeddings.py`）用的嵌入模型。代码默认 `bge-m3:latest`；
# 留空即用该默认（本项在调用点读，不是模块级快照，改了立刻生效）。
KG_EMBED_MODEL=

# 社区摘要（`tools/build_community_summaries.py`）与综述生成
# （`tools/survey_generate.py`）各自可覆盖的模型；**留空则回退 `KG_QA_MODEL`**。
KG_SUMMARY_MODEL=
KG_SURVEY_MODEL=


# ── 3. 云端通道（⚠️ 默认关闭，且**有硬保护**）─────────────────────────────
#
# **安全设计（踩过坑之后加的）**：`src/kg_extractor.py` 里有一份 BLOCKED 集合，
# **故意不从系统注册表自动注入云端密钥** —— 防止任何 `import` 该模块的脚本
# 误调用付费 API。要真用云端，必须**同时**设 `KG_ALLOW_CLOUD=1`。
# 云端通道默认关闭。它按量计费，确认要付费调用再显式打开。
# （仓库不预设任何额度：账单与配额取决于你自己的 key。）
KG_ALLOW_CLOUD=0

# 下面这些**留空即可**，只有真要走云端时才填。
DEEPSEEK_API_KEY=
# ⚠️ 代码里 `DS_BASE` 的默认值是 `https://api.deepseek.com/v1`（**带 `/v1`**），
#    与下面这行**不一致** —— 想让代码默认生效就别拷这行（留空即可）。
DS_BASE=https://api.deepseek.com
DS_MODEL=deepseek-chat
DS_MAX_TOKENS=8192
DS_EXTRA_HEADERS=
SF_API_KEY=
COMMAND_API_KEY=
ANTHROPIC_AUTH_TOKEN=


# ── 4. 抽取行为（一般不用改）──────────────────────────────────────────────
# 提示词风格：`split` = 实体与关系分两轮问（默认，更稳）。
KG_EXTRACT_STYLE=split

# 抽取并发数。默认 1；调大会成倍提高显存/内存占用，按本机上限调，别一上来就 8+。
KG_EXTRACT_WORKERS=1

# 关系类型是否只给裸列表（`1` = 不给语义定义，用于 A/B 对照实验）。
KG_BARE_RELATION_TYPES=0

# 版面噪声剥离（`src/pdf_parser.py`）：默认 1 = 剥掉"引用本文/相似文章推荐"这类
# 页眉页脚噪声；设 `0` 可整体关闭，用于对照实验。
KG_STRIP_LAYOUT_NOISE=1

# 图净化档位（`src/graph_sanitize.py`），默认 0：
#   0 = 不净化（**默认** —— 保证既有绿灯与历史产物口径不变）
#   1 = 只做吸收（最保守，金标实测 +0.0051）  2 = 吸收 + 过滤（会删实体与边）
#   3 = 全开（再加方向见证）
KG_SANITIZE=0

# 是否**硬删**被判定为噪声的边。默认 0（不删）；改成 1 才是显式开关。
KG_SANITIZE_DROP_EDGES=0


# ── 5. 语料批处理（只在 `tools/ingest_corpus.py` 等脚本里用）──────────────
KG_INGEST_MODE=local
KG_CHUNK_CHARS=500
KG_BATCH_ID=
KG_ONLY=
CHANNEL_CHUNKS=0
CHANNEL_WORKERS=1

# 抽取记录的落盘目录（留空则不记）。
KG_RECORD_DIR=

# 是否强制重跑已入库的语料（跳过"已存在就跳过"的短路）。默认关（空值即关）。
KG_FORCE=0

# QLoRA 蒸馏训练的底座模型（`tools/distill_qlora_train.py` 的 `--base` 默认值）。
KG_DISTILL_BASE=Qwen/Qwen3-4B

# 指标溯源归档目录（`tools/metric_provenance.py`）。
# 默认 `data/quality/archive/metric-provenance`；测试会把它指到临时目录，
# **真实归档只由人手动产生**。
KG_ARCHIVE_DIR=

# 编辑计划（edit-plans）落盘目录（`src/app.py`）。默认 `data/quality/edit-plans`。
KG_EDIT_PLAN_DIR=


# ── 6. 网络代理（**仅在国内网络访问 HuggingFace / arXiv 时需要**）─────────
#
# 实测：本机 `arxiv.org` 与 `export.arxiv.org` **全部不可达（HTTP 000）**，
# 而 OpenAlex / Crossref / Semantic Scholar 可达。要拉 arXiv PDF 或
# HuggingFace 模型时才需要下面这些。
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
HF_ENDPOINT=
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=


# ── 7. 自检与验证脚本（`tools/cdp_verify_*.py` / `tools/kg.py` 等，手跑时用）──
#
# 这一组**只在离线核对产物时用**，日常开发与演示不用管。留空即用代码里的
# 默认值；下面写出来的就是那些默认值。

# 静态站点基址。⚠️ 各脚本的兜底**不统一**：`tools/cdp_verify_papers.py` 等用
# 8000，而 `cdp_verify_batch_upload.py` / `cdp_verify_paper_filter.py` 等用
# `8098/web` —— 手跑时按实际起的服务填，别照抄。
KG_STATIC=http://127.0.0.1:8000
KG_STATIC_PLAIN=http://127.0.0.1:8098/web

# 后端问答接口基址（`tools/kg.py` 的 CLI 与 `tools/cdp_verify_global_qa.py`）。
KG_API=http://127.0.0.1:8000
KG_QA_BASE=http://127.0.0.1:8000

# 全局问答自检用的图 id、两个示例问题、以及页面等待上限（毫秒）。
KG_QA_GID=ad690dfb
KG_QA_GLOBAL_Q=这批文献整体在研究什么？
KG_QA_PAPER_Q=What method does this paper propose?
KG_QA_TIMEOUT_MS=240000

# 星云图数据源（`tools/diag_atlas.py`）。默认读 `web/kg-data/force-full.json`。
ATLAS_SRC=force-full.json

# 文档数字核对（`tools/check_doc_numbers.py`）：默认只画 ⚠️ 提示；设 1 会把
# "回归项数变了"这类软提示升级成错误（规模/指标类数字本来就是硬断言）。
KG_STRICT_PYTEST=0


# ───────────────────────────────────────────────────────────────────────────
# 本次补齐于 2026-09-19，扫描方式：grep os.environ/os.getenv
# （含 `os.environ.get(...)` / `os.getenv(...)` / `os.environ["..."]` 三种写法）。
# 复核方式：重跑差集比对（扫代码 vs 扫本文件），应报「模板缺失 0 个」。
# 被本文件遗漏过的两个高影响项：`KG_OLLAMA_TIMEOUT` / `KG_OLLAMA_RETRIES`。
# ───────────────────────────────────────────────────────────────────────────
